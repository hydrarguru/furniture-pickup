NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/app.db
APP_ORIGIN=http://localhost:5173
MAILER=console
# Required in production (>= 32 chars)
# SESSION_SECRET=

# Garage (S3). Values below are dev placeholders; create real keys with deploy/garage/init.sh.
S3_ENDPOINT=http://127.0.0.1:3900
# S3_PUBLIC_ENDPOINT=https://s3.example.se   # browser-facing URL in production
S3_REGION=garage
S3_BUCKET=pickup-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Geocoding for the admin map (OpenStreetMap Nominatim). Defaults to the public server.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
