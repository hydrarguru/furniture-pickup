# /etc/hamtning/backup.env: settings for deploy/backup/*.sh. Owner root, mode 0600.
# Backups go to an off-site, S3-compatible bucket (Backblaze B2, Hetzner Object Storage,
# Scaleway, AWS, ...) with restic, which encrypts them before they leave the server.

# FILL IN: the bucket, e.g. s3:https://s3.eu-central-003.backblazeb2.com/hamtning-backup
RESTIC_REPOSITORY=
# The encryption password. Create it with: openssl rand -base64 48 > /etc/hamtning/restic-password
# KEEP A COPY OUTSIDE THE SERVER (a password manager): without it the backups cannot be read.
RESTIC_PASSWORD_FILE=/etc/hamtning/restic-password
# FILL IN: the backup bucket's access key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DATABASE_PATH=/var/lib/hamtning/app.db
GARAGE_CONFIG=/etc/garage.toml
STAGE_DIR=/var/backups/hamtning
API_ENV=/etc/hamtning/api.env
APP_DIR=/opt/hamtning/app

# Optional: a URL to call after each successful run (an Uptime Kuma "push" monitor), so you
# hear about it when backups stop. Separate URL for the monthly restore test.
HEARTBEAT_URL=
RESTORE_TEST_HEARTBEAT_URL=

# Only when Garage runs in Docker (deploy/docker/README.md): how to reach the garage command.
# GARAGE_CMD="docker compose -f /opt/hamtning/app/docker-compose.yml exec -T garage /garage -c /etc/garage.toml"
