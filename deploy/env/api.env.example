# /etc/hamtning/api.env: settings for the API on the VPS. Owner root:hamtning, mode 0640.
# Lines marked FILL IN need a value before the first start. deploy/garage/init.sh adds the
# storage key (S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY) itself.

NODE_ENV=production
PORT=3000
DATABASE_PATH=/var/lib/hamtning/app.db

# FILL IN: the site's address, exactly as visitors see it (used in email links and CORS).
APP_ORIGIN=https://hamta.example.se

# FILL IN: a long random string: openssl rand -base64 48
SESSION_SECRET=

# Photo storage (Garage on this machine). The browser reaches it through nginx.
S3_ENDPOINT=http://127.0.0.1:3900
# FILL IN: the storage host name nginx serves.
S3_PUBLIC_ENDPOINT=https://s3.hamta.example.se
S3_REGION=garage
S3_BUCKET=pickup-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email. Until the domain and an email provider exist, keep MAILER=console: emails are then only
# written to the log (journalctl -u hamtning-api), and customers receive nothing.
MAILER=console
# With a provider (Resend, Postmark, Amazon SES, Brevo, ...), use its SMTP settings:
# MAILER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Butiken <noreply@hamta.example.se>
